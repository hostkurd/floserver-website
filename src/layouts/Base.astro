---
import '../styles/site.css';
import { company, siteUrl } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'download' | 'docs' | 'news' | 'privacy' | 'licence' | '';
  headerDownload?: boolean;
  wide?: boolean;
  noindex?: boolean;
}
const { title, description, current = '', headerDownload = true, wide = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title === 'FloServer' ? 'FloServer: a small local server for every project' : `${title} · FloServer`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0364B5">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="FloServer">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${siteUrl}/img/og.png`}>
  <meta name="twitter:card" content="summary_large_image">
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class:list={['wrap', { 'wrap-wide': wide }]}>
      <a class="brand" href="/"><img src="/favicon.svg" alt="" width="30" height="30">FloServer{current === 'docs' && <span class="sub">Docs</span>}</a>
      <nav class="site-nav" aria-label="Main">
        <a href="/#features">Features</a>
        <a href="/download/" aria-current={current === 'download' ? 'page' : undefined}>Download</a>
        <a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
        <a href="/news/" aria-current={current === 'news' ? 'page' : undefined}>What's new</a>
        {headerDownload && <a class="btn btn-primary btn-sm" href="/download/">Download</a>}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap foot-cols">
      <div class="about">
        <div class="foot-brand"><img src="/favicon.svg" alt="" width="22" height="22">FloServer</div>
        <p>By {company.name} · {company.address}</p>
      </div>
      <nav aria-label="Product"><strong>Product</strong><a href="/download/">Download</a><a href="/#features">Features</a><a href="/docs/">Docs</a><a href="/news/">What's new</a></nav>
      <nav aria-label="Legal"><strong>Legal</strong><a href="/privacy/">Privacy</a><a href="/licence/">Licence</a></nav>
      <nav aria-label="Contact"><strong>Contact</strong><a href={`mailto:${company.email}`}>{company.email}</a></nav>
    </div>
    <div class="wrap foot-base">© {year} {company.name}. FloServer is free to use.</div>
  </footer>
  <a class="to-top" href="#top" aria-label="Back to top" data-to-top>
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 14V4M4.5 8.5L9 4l4.5 4.5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
  <script>
    // Show the back-to-top button once the page has scrolled a screen down.
    const top = document.querySelector<HTMLElement>('[data-to-top]');
    if (top) {
      const update = () => top.classList.toggle('show', window.scrollY > window.innerHeight * 0.8);
      document.addEventListener('scroll', update, { passive: true });
      update();
      top.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  </script>
</body>
</html>
