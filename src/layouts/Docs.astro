---
import Base from './Base.astro';
import DocsSearch from '../components/DocsSearch.astro';
import { breadcrumbs } from '../lib/structured-data.js';
import { docsNav, docsPages, release, company } from '../data/site.js';

const { frontmatter, headings = [] } = Astro.props;
const { title, description, lead } = frontmatter;
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const index = docsPages.findIndex((p) => p.href === here);
const page = docsPages[index];
const prev = index > 0 ? docsPages[index - 1] : undefined;
const next = index >= 0 && index < docsPages.length - 1 ? docsPages[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const crumbs = [['Home', '/'], ['Docs', '/docs/']];
if (page && page.href.startsWith('/docs/settings/') && page.href !== '/docs/settings/') crumbs.push(['Settings', '/docs/settings/']);
if (page && page.href !== '/docs/') crumbs.push([page.title, page.href]);
const section = page && page.href !== '/docs/' ? page.group : undefined;
---
<Base title={title === 'FloServer docs' ? 'Docs' : `${title} · Docs`} description={description} current="docs" jsonLd={[breadcrumbs(crumbs)]}>
  <div class="wrap docs">
    <aside class="docs-side" aria-label="Docs">
      <div class="sticky">
        <DocsSearch />
        <nav class="docs-menu" aria-label="Docs pages">
          {docsNav.map((g) => (
            <div class="group">
              <p>{g.title}</p>
              <ul>{g.items.map((i) => <li><a href={i.href} aria-current={i.href === here ? 'page' : undefined}>{i.title}</a></li>)}</ul>
            </div>
          ))}
        </nav>
      </div>
    </aside>

    <article class="docs-main prose" data-pagefind-body>
      <details class="docs-mobile-menu" data-pagefind-ignore>
        <summary>Docs menu{page && <span> · {page.title}</span>}</summary>
        <DocsSearch mobile />
        <nav aria-label="Docs pages">
          {docsNav.map((g) => (
            <div class="group">
              <p>{g.title}</p>
              <ul>{g.items.map((i) => <li><a href={i.href} aria-current={i.href === here ? 'page' : undefined}>{i.title}</a></li>)}</ul>
            </div>
          ))}
        </nav>
      </details>
      <nav class="crumb" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/docs/">Docs</a>{section && <span aria-hidden="true"> › </span>}{section && <span>{section}</span>}
      </nav>
      <h1 data-pagefind-meta="title">{title}</h1>
      {lead && <p class="leadp" set:html={lead}></p>}
      <slot />
      {(prev || next) && (
        <nav class="pager" aria-label="Previous and next page" data-pagefind-ignore>
          {prev ? <a class="prev" href={prev.href} rel="prev"><span>Previous</span><b>{prev.title}</b></a> : <span></span>}
          {next ? <a class="next" href={next.href} rel="next"><span>Next</span><b>{next.title}</b></a> : <span></span>}
        </nav>
      )}
      <div class="docs-foot" data-pagefind-ignore>
        <span>Docs for FloServer {release.version}</span>
        <a href={`mailto:${company.email}?subject=${encodeURIComponent('Docs: ' + title)}`}>Something wrong on this page? Email us</a>
      </div>
    </article>

    {toc.length > 1 ? (
    <aside class="docs-toc" aria-label="On this page">
        <div class="sticky">
          <p class="aside-title">On this page</p>
          <nav>
            <ul>{toc.map((h) => <li class={h.depth === 3 ? 'sub' : undefined}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ul>
          </nav>
          <a class="toc-top" href="#top">Back to top</a>
        </div>
    </aside>
    ) : <div class="docs-toc" aria-hidden="true"></div>}
  </div>
</Base>

<script>
  // "On this page": mark the section being read.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a[data-toc]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length > 0) {
    let clicked: HTMLElement | null = null;
    const mark = () => {
      const line = 120;
      let current = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top - line <= 0) current = t;
      }
      // At the bottom of the page the last sections can't reach the line:
      // keep the one that was clicked, or else mark the last.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = clicked ?? targets[targets.length - 1];
      }
      for (const a of links) {
        if (a.dataset.toc === current.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const fromHash = () => {
      clicked = targets.find((t) => '#' + t.id === decodeURIComponent(location.hash)) ?? null;
      mark();
    };
    window.addEventListener('hashchange', fromHash);
    document.addEventListener('scroll', mark, { passive: true });
    fromHash();
  }

  // The left menu scrolls by itself: show the current page in it.
  const menu = document.querySelector<HTMLElement>('.docs-side .docs-menu');
  const cur = menu?.querySelector<HTMLElement>('a[aria-current="page"]');
  if (menu && cur && menu.scrollHeight > menu.clientHeight) {
    menu.scrollTop = Math.max(0, cur.offsetTop - menu.offsetTop - menu.clientHeight / 2);
  }

  // Copy buttons on code blocks.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code');
    button.addEventListener('click', async () => {
      const text = (pre.querySelector('code') ?? pre).textContent ?? '';
      try {
        await navigator.clipboard.writeText(text.replace(/\n$/, ''));
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press Ctrl+C';
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      setTimeout(() => (button.textContent = 'Copy'), 1800);
    });
    const box = document.createElement('div');
    box.className = 'code-box';
    pre.replaceWith(box);
    box.append(pre, button);
  }
</script>
