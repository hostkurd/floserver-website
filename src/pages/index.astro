---
import Base from '../layouts/Base.astro';
import { release, slogan } from '../data/site.js';
import { organization, website, softwareApplication } from '../lib/structured-data.js';

const tick = (fill, stroke) =>
  `<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="${fill}"/><path d="M5.5 10.3l3 3 6-6.6" stroke="${stroke}" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const free = [
  'Every feature included',
  'Personal, study and client work allowed',
  'Up to 500 projects',
  'No account, no email, no licence key',
  'No trial and no time limit',
];

const envs = [
  ['php', '#E8EAF6', '#3949AB', 'PHP', '8.2 to 8.5, per project, with extensions and php.ini settings'],
  ['DB', '#F3E5F5', '#7B1FA2', 'MariaDB', 'A database and user for each project'],
  ['My', '#E0F2F1', '#00695C', 'MySQL', '8.4 LTS, for projects that need MySQL itself'],
  ['Pg', '#E8EAF6', '#283593', 'PostgreSQL', 'A database and login for each project, pg_dump backups'],
  ['R', '#FDECEA', '#B3261E', 'Redis', 'Through Garnet: caches, queues and sessions'],
  ['N', '#E8F5E9', '#1B5E20', 'nginx and Apache', 'nginx serves every project; Apache for those that need .htaccess'],
  ['JS', '#E8F5E9', '#2E7D32', 'Node.js', 'With npm; dev servers run behind the project address'],
  ['B', '#FFF8E1', '#6D4C00', 'Bun and Deno', 'Or pick one of these as the JavaScript runtime'],
  ['Py', '#E6EEF7', '#2F5F8F', 'Python', 'With pip and venv, for FastAPI, Django and Flask'],
  ['C', '#FFF3E0', '#8A4B00', 'Composer', "PHP packages, using the project's PHP"],
  ['pma', '#E3F2FD', '#1565C0', 'phpMyAdmin', 'Look after databases in the browser'],
  ['@', '#F3E5F5', '#6A1B9A', 'Mailpit', 'Catches every email your projects send'],
];
const templates = ['PHP app', 'FloCMS', 'Laravel', 'WordPress', 'Node app', 'Python app', 'Static site', 'Database only', 'MCP server (Python)', 'MCP server (PHP)'];

const S = 'stroke="#0364B5" stroke-width="1.6" fill="none"';
const features = [
  [`<rect x="3" y="4" width="16" height="5" rx="1.5" ${S}/><rect x="3" y="13" width="16" height="5" rx="1.5" ${S}/>`,
    'Versions per project', 'PHP 8.2 to 8.5, MariaDB, MySQL or PostgreSQL, Node.js, Bun, Deno and Python, chosen per project and saved in <code>floserver.json</code> next to your code.'],
  [`<rect x="4" y="10" width="14" height="9" rx="2" ${S}/><path d="M7.5 10V7a3.5 3.5 0 0 1 7 0v3" ${S}/>`,
    'Trusted local HTTPS', "Every project gets <code>https://name.localhost</code>. FloServer's own certificate authority only signs <code>localhost</code> names, trusted after one Windows prompt."],
  [`<ellipse cx="11" cy="5.5" rx="7" ry="2.5" ${S}/><path d="M4 5.5v11c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-11M4 11c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" ${S}/>`,
    'A database for each project', 'Its own database and user in MariaDB, MySQL or PostgreSQL. "Copy .env lines" puts the connection settings on your clipboard. phpMyAdmin included.'],
  [`<rect x="3" y="5" width="16" height="12" rx="2" ${S}/><path d="M3.5 6l7.5 6 7.5-6" ${S} stroke-linejoin="round"/>`,
    'Catch every email', 'Mailpit catches the mail your projects send, in an inbox at <code>mail.localhost</code>, with a notice for each new one. Nothing reaches a real mailbox.'],
  [`<path d="M11 3v4M11 15v4M3 11h4M15 11h4" ${S} stroke-linecap="round"/><circle cx="11" cy="11" r="3.5" ${S}/>`,
    'Works with AI coding tools', 'Claude Code, Cursor and VS Code can see your projects, addresses, logs and caught emails through <code>flo mcp</code>, read-only. Templates for your own MCP servers too.'],
  [`<rect x="4" y="4" width="14" height="5" rx="1.5" ${S}/><rect x="4" y="13" width="14" height="5" rx="1.5" ${S}/><path d="M7 6.5h.01M7 15.5h.01" stroke="#0364B5" stroke-width="2" stroke-linecap="round"/>`,
    'Redis for caches and queues', 'One shared Redis server through Garnet. Each project gets its own key prefix and <code>REDIS_</code> lines, ready for Laravel.'],
  [`<path d="M15 4.5a7 7 0 1 0 2.5 9.5A5.5 5.5 0 0 1 15 4.5z" ${S} stroke-linejoin="round"/>`,
    'Projects sleep when idle', 'PHP pools stop after a quiet spell and wake on the next request, so projects you aren\'t using cost almost nothing.'],
  [`<rect x="3" y="3" width="7" height="7" rx="1.5" ${S}/><rect x="12" y="3" width="7" height="7" rx="1.5" ${S}/><rect x="3" y="12" width="7" height="7" rx="1.5" ${S}/><path d="M15.5 12.5v6M12.5 15.5h6" stroke="#0364B5" stroke-width="1.6"/>`,
    'Start from a template', 'PHP app, FloCMS, WordPress, Laravel, Node app, Python app, MCP server, static site or database only. Or keep a shared <code>www</code> folder like htdocs.'],
  [`<rect x="3" y="4" width="16" height="14" rx="2" ${S}/><path d="M6.5 9l2.5 2-2.5 2M11 14h4" ${S} stroke-linecap="round"/>`,
    "Your terminal, the project's versions", "<code>php</code>, <code>composer</code>, <code>node</code>, <code>npm</code>, <code>python</code> and <code>pip</code> use the versions of the project you're in. Plus the <code>flo</code> command line."],
  [`<path d="M4 7h14v11H4zM7 4h8v3" ${S} stroke-linejoin="round"/><path d="M11 10v5M8.8 12.8L11 15l2.2-2.2" ${S} stroke-linecap="round"/>`,
    'Backup and restore', 'Save a project as a zip with its database, restore it, or start a new project from a backup. Rename a project in one step.'],
  [`<path d="M11 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6z" ${S} stroke-linejoin="round"/><path d="M8 11l2 2 4-4" ${S} stroke-linecap="round"/>`,
    'Signed, checked downloads', 'The runtime list is signed (Ed25519) and every download is checked with SHA-256. App updates come through the same signed list.'],
  [`<circle cx="11" cy="11" r="8" ${S}/><path d="M3 11h16M11 3c2.5 2.5 2.5 13.5 0 16M11 3c-2.5 2.5-2.5 13.5 0 16" ${S}/>`,
    'English, Arabic and Kurdish', 'The app speaks English, Arabic and Kurdish (Sorani), right to left where it should. Works with screen readers.'],
];
const down = '<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2v10M4.5 7.5L9 12l4.5-4.5M3 15.5h12" stroke="#FFFFFF" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base title="FloServer" description="A free, lightweight local web development server for Windows: PHP, MariaDB, MySQL, PostgreSQL, Redis, Node.js, Bun, Python, nginx or Apache per project, each with trusted HTTPS." current="home" headerDownload={false} jsonLd={[organization, website, softwareApplication]}>
  <section class="hero bg-pale">
    <div class="wrap">
      <div class="hero-text">
        <p class="pill">Version {release.version} beta · Windows 10 and 11</p>
        <h1>A small local server for every project.</h1>
        <p class="slogan">{slogan}</p>
        <p class="intro">One native app runs PHP, MariaDB, MySQL or PostgreSQL, Redis, Node.js, Bun, Deno, Python, nginx or Apache and Composer for each project, with its own versions, at its own <code>https://name.localhost</code> with trusted HTTPS.</p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href="/download/"><Fragment set:html={down} />Download for Windows</a>
          <a class="btn btn-ghost btn-lg" href="#features">See what it does</a>
        </div>
        <p class="small">{release.size} · Windows 10 or 11, 64-bit · Installs without admin rights</p>
      </div>
      <div class="hero-shot">
        <img src="/img/docs/window-general.png" width="1106" height="713" alt="The FloServer window: a list of projects, each with its versions and state, and the selected project's settings on the right">
      </div>
    </div>
  </section>

  <section class="section-tight border-b">
    <div class="wrap stats">
      <div><div class="stat-n">~2 MB</div><div class="stat-l">memory for the service when idle</div></div>
      <div><div class="stat-n">&lt; 100 ms</div><div class="stat-l">to open the window</div></div>
      <div><div class="stat-n">Native C++</div><div class="stat-l">no Electron, no browser inside</div></div>
      <div><div class="stat-n">0</div><div class="stat-l">telemetry, accounts or admin prompts</div></div>
    </div>
  </section>

  <section class="section border-b" aria-labelledby="free-title">
    <div class="wrap">
      <div class="free">
        <div class="free-left">
          <p class="kicker">FloServer for Windows</p>
          <h2 id="free-title">Totally free.</h2>
          <div class="free-price"><b>$0</b><span>for personal and commercial use</span></div>
          <span class="spacer"></span>
          <a class="btn btn-white btn-md" href="/download/">Download free</a>
        </div>
        <div class="free-right">
          <p>What you get</p>
          <ul class="ticks">
            {free.map((t) => <li><Fragment set:html={tick('#DFF6DD', '#0E700E')} /><span>{t}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="env-title">
    <div class="wrap">
      <p class="eyebrow">Supported environments</p>
      <h2 id="env-title" class="title">The stack you already use, ready in one place.</h2>
      <p class="lead">Download only what you need. Each project picks its own versions, and several versions can be installed side by side.</p>
      <ul class="envs">
        {envs.map(([m, bg, fg, name, d]) => (
          <li><span class="mark" aria-hidden="true" style={`background:${bg};color:${fg}`}>{m}</span><span><b>{name}</b><span class="d">{d}</span></span></li>
        ))}
      </ul>
      <div class="templates">
        <span>Templates:</span>
        <ul>{templates.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <h2 class="title">Everything a project needs, and nothing running when you don't need it.</h2>
      <div class="features">
        {features.map(([svg, h, p]) => (
          <div class="feat">
            <div class="ico"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" set:html={svg}></svg></div>
            <h3>{h}</h3>
            <p set:html={p}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="see-title">
    <div class="wrap">
      <p class="eyebrow">See it</p>
      <h2 id="see-title" class="title">A plain Windows app. Nothing to configure by hand.</h2>
      <div class="shots">
        <figure><img src="/img/docs/new-project.png" width="1106" height="713" loading="lazy" alt="The New project screen with its template cards"><figcaption><b>New project.</b> Pick a template, a name and the versions.</figcaption></figure>
        <figure><img src="/img/docs/settings-php.png" width="1026" height="713" loading="lazy" alt="Settings on the PHP page with extensions and php.ini values"><figcaption><b>PHP settings.</b> Extensions and php.ini values, per PHP version.</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <p class="eyebrow">Get started</p>
      <h2 id="steps-title" class="title">Up and running in three steps.</h2>
      <ol class="steps3">
        <li><h3>Download and install</h3><p>One small setup for your Windows user. No admin rights, no account.</p><a href="/docs/install/">Install FloServer →</a></li>
        <li><h3>Pick your runtimes</h3><p>Choose the PHP, database, Node.js or Python versions to download. Each file is checked first.</p><a href="/docs/first-start/">First start →</a></li>
        <li><h3>Create a project</h3><p>Start from a template or add a folder you have. It opens at its own .localhost address.</p><a href="/docs/create-project/">Create a project →</a></li>
      </ol>
    </div>
  </section>

  <section class="section bg-grey">
    <div class="wrap split">
      <div>
        <h2 class="title" style="font-size:34px">Settings live with the code.</h2>
        <p class="lead">Each project keeps its versions in a small <code>floserver.json</code>. Commit it, and the next person who opens the folder in FloServer gets the same PHP, database and web server. <a href="/docs/floserver-json/">Every key it can hold</a>.</p>
      </div>
      <pre class="code"><span class="c">// floserver.json</span>
{`{
  "php": "8.2",
  "node": "22",
  "database": "mariadb-11.4",
  "web": "nginx",
  "root": "public",
  "extensions": ["intl", "gd"]
}`}</pre>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <img src="/favicon.svg" alt="" width="96" height="96">
      <div class="text">
        <h2>Set up your first project.</h2>
        <p>Windows 10 or 11, 64-bit. macOS and Linux are planned.</p>
      </div>
      <a class="btn btn-white btn-lg" href="/download/">Download FloServer {release.version}</a>
    </div>
  </section>
</Base>
