---
import Base from '../layouts/Base.astro';
import { release, slogan } from '../data/site.js';
import { organization, website, softwareApplication } from '../lib/structured-data.js';

const down = '<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2v10M4.5 7.5L9 12l4.5-4.5M3 15.5h12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const tick = '<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9.4l3.2 3.1L14 5.6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';

// What FloServer runs, grouped as Settings → Runtimes groups them.
const stack = [
  ['Languages', [
    ['PHP', '8.2 to 8.5, with extensions and php.ini per version and per project'],
    ['Node.js', 'Long-term support versions, with npm'],
    ['Bun and Deno', 'As a project\'s JavaScript runtime instead of Node.js'],
    ['Python', 'With pip and a .venv per project, for FastAPI, Django and Flask'],
  ]],
  ['Databases', [
    ['MariaDB', 'Long-term support versions; the default'],
    ['MySQL', '8.4 LTS, for projects that need MySQL itself'],
    ['PostgreSQL', 'With pg_dump backups and pdo_pgsql for PHP'],
    ['Redis', 'Through Garnet, for caches, queues and sessions'],
  ]],
  ['Web servers', [
    ['nginx', 'Serves every project'],
    ['Apache', 'For projects that need .htaccess'],
  ]],
  ['Tools', [
    ['Composer', 'PHP packages, with the project\'s PHP'],
    ['phpMyAdmin', 'MariaDB and MySQL in your browser'],
    ['Mailpit', 'Catches the email your projects send'],
  ]],
];
const templates = ['PHP app', 'FloCMS', 'Laravel', 'WordPress', 'Node app', 'Python app', 'Static site', 'Database only', 'MCP server (Python)', 'MCP server (PHP)'];

const S = 'stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"';
const more = [
  [`<rect x="4" y="10" width="14" height="9" rx="2" ${S}/><path d="M7.5 10V7a3.5 3.5 0 0 1 7 0v3" ${S}/>`,
    'Trusted local HTTPS', "Every project at <code>https://name.localhost</code>. FloServer's own certificate authority signs <code>localhost</code> names only."],
  [`<path d="M15 4.5a7 7 0 1 0 2.5 9.5A5.5 5.5 0 0 1 15 4.5z" ${S}/>`,
    'Sleeps when idle', 'Projects, databases, Mailpit and Redis stop after a quiet spell and wake on the next request.'],
  [`<rect x="3" y="4" width="16" height="14" rx="2" ${S}/><path d="M6.5 9l2.5 2-2.5 2M11 14h4" ${S}/>`,
    "Your terminal, the project's versions", '<code>php</code>, <code>composer</code>, <code>node</code>, <code>bun</code>, <code>python</code> and the rest follow the folder you\'re in.'],
  [`<path d="M4 7h14v11H4zM7 4h8v3" ${S}/><path d="M11 10v5M8.8 12.8L11 15l2.2-2.2" ${S}/>`,
    'Backup and restore', 'A project and its database in one zip. Restore it, or start a new project from it.'],
  [`<path d="M11 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6z" ${S}/><path d="M8 11l2 2 4-4" ${S}/>`,
    'Signed, checked downloads', 'The runtime list is signed with Ed25519, and every file is checked with SHA-256 before it runs.'],
  [`<circle cx="11" cy="11" r="8" ${S}/><path d="M3 11h16M11 3c2.5 2.5 2.5 13.5 0 16M11 3c-2.5 2.5-2.5 13.5 0 16" ${S}/>`,
    'English, Arabic and Kurdish', 'Right to left where it should be, and usable with a screen reader.'],
];

const faqs = [
  ['Is FloServer really free?', 'Yes, for personal, study and commercial work, with every feature and up to 500 projects. There is no account, licence key or trial.'],
  ['Does it need admin rights?', 'No. It installs for your Windows user, runs no Windows services and never edits the hosts file. Windows asks once whether to trust its local certificate.'],
  ['Does it send anything about me?', 'No. FloServer has no telemetry and no account. It goes online to check for updates and to download the runtimes you choose.'],
  ['Can I keep my projects where they are?', 'Yes. Add any folder as a project. FloServer keeps its versions in a small floserver.json next to your code, and never moves your files.'],
  ['What about macOS and Linux?', 'They are planned. Windows 10 and 11 come first.'],
  ['How do updates work?', 'FloServer checks once a day and asks before installing. Your projects, databases and settings stay as they are.'],
];
---
<Base title="FloServer" description="A free, lightweight local web development server for Windows: PHP, MariaDB, MySQL, PostgreSQL, Redis, Node.js, Bun, Python, nginx or Apache per project, each with trusted HTTPS." current="home" headerDownload={false} jsonLd={[organization, website, softwareApplication]}>
  <section class="h3-hero">
    <div class="wrap h3-hero-grid">
      <div class="h3-hero-text">
        <p class="h3-version"><a href={`/news/${release.version}/`}>Version {release.version} beta: PostgreSQL, Redis, mail and AI tools</a></p>
        <h1>A small local server for every project.</h1>
        <p class="h3-slogan">{slogan}</p>
        <p class="h3-intro">One native Windows app runs PHP, Node.js, Python and your databases for each project, with its own versions, at its own <code>https://name.localhost</code>.</p>
        <div class="h3-actions">
          <a class="btn btn-white btn-lg" href="/download/"><Fragment set:html={down} />Download for Windows</a>
          <a class="btn h3-btn-line btn-lg" href="/docs/">Read the docs</a>
        </div>
        <p class="h3-meta">Free · {release.size} · Windows 10 or 11, 64-bit · No admin rights</p>
      </div>
    </div>
    <div class="wrap h3-shot-wrap">
      <figure class="h3-shot">
        <img src="/img/docs/window-general.png" width="1106" height="713" alt="The FloServer window: a list of projects, each with its versions and state, and the selected project's settings on the right">
      </figure>
    </div>
  </section>

  <section class="h3-proof" aria-label="Measured on every build">
    <div class="wrap">
      <dl class="h3-nums">
        <div><dt>Service memory when idle</dt><dd>~2 MB</dd></div>
        <div><dt>Time to open the window</dt><dd>&lt; 100 ms</dd></div>
        <div><dt>Built with</dt><dd>Native C++</dd></div>
        <div><dt>Telemetry and accounts</dt><dd>None</dd></div>
      </dl>
      <p class="h3-proof-note">Memory and start-up time are measured on every build, and a build that goes over fails.</p>
    </div>
  </section>

  <section class="h3-sec" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="h3-head">
        <h2 id="stack-title">The stack you already use, in one app.</h2>
        <p>Download only what you need. Each project picks its own versions, and several versions sit side by side.</p>
      </div>
      <div class="h3-stack">
        {stack.map(([group, items]) => (
          <div class="h3-stack-col">
            <h3>{group}</h3>
            <ul>
              {items.map(([name, d]) => <li><b>{name}</b><span>{d}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="h3-templates">
        <h3>Start from a template</h3>
        <ul>{templates.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="h3-sec h3-tint" id="features" aria-label="What it does">
    <div class="wrap h3-rows">
      <div class="h3-row">
        <div class="h3-row-text">
          <h2>Each project carries its own setup.</h2>
          <p>PHP, the database, the JavaScript runtime and the web server are chosen per project and saved in a small <code>floserver.json</code>. Commit it, and the next person who opens the folder gets the same stack.</p>
          <a href="/docs/floserver-json/">Every key it can hold</a>
        </div>
        <pre class="code h3-code" aria-label="An example floserver.json"><span class="c">// floserver.json</span>
{`{
  "php": "8.4",
  "database": "postgresql-17",
  "bun": "1.3",
  "web": "nginx",
  "root": "public",
  "redis": true,
  "extensions": ["intl", "gd"]
}`}</pre>
      </div>

      <div class="h3-row h3-row-flip">
        <div class="h3-row-text">
          <h2>A database for every project.</h2>
          <p>Each project gets its own database and login in MariaDB, MySQL or PostgreSQL. <strong>Copy .env lines</strong> puts the connection settings on your clipboard, in the shape Laravel or FloCMS expects.</p>
          <a href="/docs/databases/">Databases</a>
        </div>
        <figure class="h3-frame"><img src="/img/docs/window-database.png" width="1106" height="713" loading="lazy" alt="The project panel on the Database tab, with Copy .env lines and Open in phpMyAdmin"></figure>
      </div>

      <div class="h3-row">
        <div class="h3-row-text">
          <h2>PHP, set up the way you work.</h2>
          <p>Turn extensions on and change php.ini values for a PHP version, or for one project only. Opcache is always on.</p>
          <a href="/docs/settings/php/">PHP settings</a>
        </div>
        <figure class="h3-frame"><img src="/img/docs/settings-php.png" width="1026" height="713" loading="lazy" alt="Settings on the PHP page with extensions and php.ini values"></figure>
      </div>

      <div class="h3-row h3-row-flip">
        <div class="h3-row-text">
          <h2>Mail that never leaves your PC.</h2>
          <p>Mailpit catches every email your projects send, in an inbox at <code>mail.localhost</code>. PHP's <code>mail()</code>, <code>wp_mail</code> and PHPMailer go there with no change to your code, and a notice shows each new one.</p>
          <a href="/docs/mail/">Mail</a>
        </div>
        <pre class="code h3-code" aria-label="Mail lines from Copy .env lines, and flo mail commands"><span class="c"># In Copy .env lines</span>
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

<span class="c"># In any terminal</span>
flo mail test
flo mail open</pre>
      </div>

      <div class="h3-row">
        <div class="h3-row-text">
          <h2>Your AI tools can see your projects.</h2>
          <p>Claude Code, Cursor and VS Code can read your projects, versions, addresses, logs and caught emails through <code>flo mcp</code>. Read-only: they can't change anything or see passwords. Two templates help you build an MCP server of your own.</p>
          <a href="/docs/ai-tools/">AI coding tools</a>
        </div>
        <pre class="code h3-code" aria-label="Adding FloServer to Claude Code"><span class="c"># Claude Code</span>
claude mcp add floserver -- flo mcp

<span class="c"># Cursor and Claude Desktop</span>
{`{ "mcpServers": { "floserver": {
    "command": "flo", "args": ["mcp"] } } }`}</pre>
      </div>
    </div>
  </section>

  <section class="h3-sec" aria-labelledby="more-title">
    <div class="wrap">
      <div class="h3-head">
        <h2 id="more-title">And the rest of what a project needs.</h2>
      </div>
      <ul class="h3-more">
        {more.map(([svg, h, p]) => (
          <li>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" set:html={svg}></svg>
            <h3>{h}</h3>
            <p set:html={p}></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="h3-sec h3-tint" aria-labelledby="free-title">
    <div class="wrap h3-free">
      <div>
        <h2 id="free-title">Free, with nothing held back.</h2>
        <p>FloServer is free for personal, study and commercial work. Every feature is in the free version, because there is no other version.</p>
        <a class="btn btn-primary btn-md" href="/download/">Download free</a>
      </div>
      <ul class="h3-ticks">
        {['Every feature included', 'Personal, study and client work allowed', 'Up to 500 projects', 'No account, email or licence key', 'No trial and no time limit'].map((t) => (
          <li><Fragment set:html={tick} />{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="h3-sec" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="h3-head"><h2 id="steps-title">Up and running in three steps.</h2></div>
      <ol class="h3-steps">
        <li><h3>Install</h3><p>One small setup for your Windows user. No admin rights and no account.</p><a href="/docs/install/">Install FloServer</a></li>
        <li><h3>Pick your runtimes</h3><p>Choose the PHP, database, Node.js or Python versions to download. Each file is checked first.</p><a href="/docs/first-start/">First start</a></li>
        <li><h3>Create a project</h3><p>Start from a template or add a folder you have. It opens at its own .localhost address.</p><a href="/docs/create-project/">Create a project</a></li>
      </ol>
    </div>
  </section>

  <section class="h3-sec h3-tint" aria-labelledby="faq-title">
    <div class="wrap h3-faq-wrap">
      <h2 id="faq-title">Questions</h2>
      <div class="h3-faq">
        {faqs.map(([q, a]) => (
          <details><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <img src="/favicon.svg" alt="" width="96" height="96">
      <div class="text">
        <h2>Set up your first project.</h2>
        <p>Windows 10 or 11, 64-bit. macOS and Linux are planned.</p>
      </div>
      <a class="btn btn-white btn-lg" href="/download/">Download FloServer {release.version}</a>
    </div>
  </section>
</Base>
