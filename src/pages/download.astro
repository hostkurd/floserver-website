---
import Base from '../layouts/Base.astro';
import { release } from '../data/site.js';
import { organization, softwareApplication, breadcrumbs } from '../lib/structured-data.js';
const down = '<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2v10M4.5 7.5L9 12l4.5-4.5M3 15.5h12" stroke="#FFFFFF" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base title="Download" description={`Download FloServer ${release.version} for Windows 10 and 11. Free for personal and commercial use, no account.`} current="download" headerDownload={false} jsonLd={[organization, softwareApplication, breadcrumbs([['Home', '/'], ['Download', '/download/']])]}>
  <section class="bg-pale">
    <div class="wrap split" style="padding-top:80px;padding-bottom:80px;gap:48px">
      <div style="flex:1 1 460px">
        <h1 style="margin:0;font-size:48px;line-height:1.1;font-weight:700;letter-spacing:-0.02em">Download FloServer</h1>
        <p style="margin:16px 0 0;font-size:19px;color:var(--body)">Version {release.version} (beta) · released {release.date}</p>
      </div>
      <div class="dl-card" style="flex:1 1 420px">
        <div class="head">
          <img src="/favicon.svg" alt="" width="56" height="56">
          <div>
            <div style="font-weight:600;font-size:18px">FloServer for Windows</div>
            <div style="font-size:14px;color:var(--muted)">{release.setupFile} · {release.size}</div>
          </div>
        </div>
        <a class="btn btn-primary btn-lg" href={release.setupUrl}><Fragment set:html={down} />Download for Windows</a>
        <p style="margin:14px 0 0;font-size:15px;font-weight:600;color:var(--green);text-align:center">Totally free for personal and commercial use · Up to 500 projects</p>
        <p style="margin:4px 0 0;font-size:14px;color:var(--muted);text-align:center">Windows 10 or 11, 64-bit · No account</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split" style="padding-top:72px;padding-bottom:72px;align-items:flex-start">
      <div style="flex:1 1 460px">
        <h2 style="margin:0 0 28px;font-size:28px;font-weight:700">Installing</h2>
        <div class="steps">
          <div class="step"><span class="num">1</span><div><h3>Run the setup</h3><p>Open <code>{release.setupFile}</code>. It installs for your user only and doesn't ask for admin rights.</p></div></div>
          <div class="step"><span class="num">2</span><div><h3>If Windows SmartScreen appears</h3><p>This beta isn't code-signed yet, so Windows may show "Windows protected your PC". Click <strong>More info</strong>, then <strong>Run anyway</strong>.</p></div></div>
          <div class="step"><span class="num">3</span><div><h3>Choose your runtimes</h3><p>On first start FloServer downloads the PHP, MariaDB and Node.js versions you pick, checked against its signed list.</p></div></div>
          <div class="step"><span class="num">4</span><div><h3>Trust local HTTPS once</h3><p>Windows asks once to trust FloServer's local certificate authority. It only covers <code>localhost</code> names.</p></div></div>
        </div>
        <p style="margin:28px 0 0;font-size:15px"><a href="/docs/install/">The full install guide, with screenshots</a></p>
      </div>
      <div style="flex:1 1 360px;display:flex;flex-direction:column;gap:20px">
        <div class="box">
          <h2>Requirements</h2>
          <ul style="margin:0;padding-left:20px;line-height:1.9">
            <li>Windows 10 or Windows 11</li>
            <li>64-bit (x64)</li>
            <li>No admin rights needed</li>
            <li>Internet for the first runtime download</li>
          </ul>
        </div>
        <div class="box">
          <h2>Already have FloServer?</h2>
          <p>It offers the new version itself, within a day. Or run this setup now and choose <strong>Update</strong>: your projects, databases and settings stay. <a href={`/news/${release.version}/`}>What's new in {release.version}</a></p>
        </div>
        <div class="box warn">
          <h2>This is a beta</h2>
          <p>Things may change between versions. FloServer checks for updates once a day and asks before installing. To check now: Settings → General → Check now.</p>
        </div>
        <div class="box">
          <h2>macOS and Linux</h2>
          <p>Planned. Windows comes first.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
